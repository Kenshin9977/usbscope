<Window x:Class="UsbScope.Tray.PortsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsbScope"
        Width="720" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="UsbScope" FontSize="20" FontWeight="SemiBold" />
            <Button Content="Refresh" Margin="16,0,0,0" Padding="10,2" Click="OnRefreshClick" />
        </StackPanel>
        <TextBlock Name="StatusText" DockPanel.Dock="Bottom" Foreground="Gray" Margin="0,8,0,0" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Physical ports (firmware)" FontWeight="SemiBold" Margin="0,4,0,4" />
            <ListView Grid.Row="1" Name="PortsList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding PhysicalType}" />
                        <GridViewColumn Header="Label" Width="120" DisplayMemberBinding="{Binding Label}" />
                        <GridViewColumn Header="Port ID" Width="200" DisplayMemberBinding="{Binding PortId}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Grid.Row="2" Text="Devices on the bus" FontWeight="SemiBold" Margin="0,12,0,4" />
            <ListView Grid.Row="3" Name="DevicesList">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Device" Width="250" DisplayMemberBinding="{Binding FriendlyName}" />
                        <GridViewColumn Header="Vendor" Width="180" DisplayMemberBinding="{Binding Manufacturer}" />
                        <GridViewColumn Header="VID:PID" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VendorId, StringFormat={}{0:X4}}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Speed" Width="160" DisplayMemberBinding="{Binding NegotiatedRate}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
